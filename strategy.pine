//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Bollinger Squeeze — 20th Percentile + Breakout
//  Detects volatility compression by ranking current BB bandwidth against
//  the previous N bars, then arms a breakout trigger when the squeeze releases.
//  Tuned for 30-minute charts.
// ═══════════════════════════════════════════════════════════════════════════
indicator("Bollinger Squeeze — 20th Percentile Breakout", shorttitle="BBSQZ P20",
     overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ─────────────────────────── INPUTS ───────────────────────────
grpBB = "Bollinger Bands"
src    = input.source(close, "Source",    group = grpBB)
bbLen  = input.int(20,   "BB Length",     minval = 2,   group = grpBB)
bbMult = input.float(2.0,"BB StdDev",     minval = 0.1, step = 0.1, group = grpBB)

grpSQ = "Squeeze Detection"
lookback   = input.int(240, "Percentile Lookback (bars)", minval = 30,
     tooltip = "240 bars on 30m ≈ 5 days of 24/7 trading, or ~18 US equity sessions. " +
               "Long enough for a stable percentile, short enough to stay inside the current volatility regime. " +
               "Use 120 for faster/scalping, 480 for slower swing context.", group = grpSQ)
pctThresh  = input.float(20, "Squeeze Percentile (%)", minval = 1, maxval = 50, step = 1, group = grpSQ)
minSqzBars = input.int(6, "Min Bars in Squeeze", minval = 1,
     tooltip = "6 bars = 3 hours on 30m. Filters one-bar flukes.", group = grpSQ)

grpBO = "Breakout Trigger"
boWindow = input.int(10,  "Breakout Window (bars after release)", minval = 1, group = grpBO)
useClose = input.bool(true,  "Require CLOSE beyond range (vs wick)", group = grpBO)
useMom   = input.bool(true,  "Require momentum agreement",           group = grpBO)
useVol   = input.bool(false, "Require volume expansion",             group = grpBO)
volLen   = input.int(20,  "Volume MA Length", minval = 1, group = grpBO)
volMult  = input.float(1.5,"Volume Multiple", minval = 0.1, step = 0.1, group = grpBO)

grpVIS = "Visuals"
showBox = input.bool(true, "Draw squeeze boxes",       group = grpVIS)
showBG  = input.bool(true, "Shade squeeze background", group = grpVIS)
showTbl = input.bool(true, "Show info table",          group = grpVIS)

// ──────────────────────── BOLLINGER BANDS ─────────────────────
basis = ta.sma(src, bbLen)
dev   = bbMult * ta.stdev(src, bbLen)
upper = basis + dev
lower = basis - dev

// Bandwidth normalised by the basis so it is comparable across price levels
bbw = basis != 0 ? (upper - lower) / basis * 100 : na

// ─────────────────── PERCENTILE RANK vs PRIOR BARS ────────────
// ta.percentrank compares the current bandwidth against the PREVIOUS `lookback`
// bars. A value of 20 means: only 20% of recent bars were tighter than now.
rank       = ta.percentrank(bbw, lookback)
enoughData = bar_index > lookback + bbLen
inSqueeze  = enoughData and not na(rank) and rank <= pctThresh
extreme    = inSqueeze and rank <= pctThresh / 2

// ─────────────────────────── MOMENTUM ─────────────────────────
// TTM-style: linear regression of price vs the midline of the recent range
midRange = math.avg(math.avg(ta.highest(high, bbLen), ta.lowest(low, bbLen)), ta.sma(close, bbLen))
mom      = ta.linreg(src - midRange, bbLen, 0)

// ───────────────────── SQUEEZE STATE MACHINE ──────────────────
var float sqzHi    = na
var float sqzLo    = na
var int   sqzCount = 0

sqzStart = inSqueeze and not inSqueeze[1]
released = not inSqueeze and inSqueeze[1]

if sqzStart
    sqzHi    := high
    sqzLo    := low
    sqzCount := 1
else if inSqueeze
    sqzHi    := math.max(sqzHi, high)
    sqzLo    := math.min(sqzLo, low)
    sqzCount += 1

// ───────────────────── BREAKOUT ARMING LOGIC ──────────────────
var bool  armed     = false
var int   barsSince = 0
var float boHi      = na
var float boLo      = na

if released and sqzCount >= minSqzBars
    armed     := true
    barsSince := 0
    boHi      := sqzHi
    boLo      := sqzLo
else if inSqueeze
    armed := false          // re-entered compression, void the pending setup
else if armed
    barsSince += 1
    if barsSince > boWindow
        armed := false      // setup expired without resolving

// ───────────────────────── TRIGGERS ───────────────────────────
volOk  = not useVol or volume > ta.sma(volume, volLen) * volMult
upTest = useClose ? close > boHi : high > boHi
dnTest = useClose ? close < boLo : low  < boLo

longBO  = armed and upTest and volOk and (not useMom or mom > 0)
shortBO = armed and dnTest and volOk and (not useMom or mom < 0)

if longBO or shortBO
    armed := false

// ────────────────────────── PLOTTING ──────────────────────────
pUp = plot(upper, "Upper Band", color.new(color.blue, 25))
pLo = plot(lower, "Lower Band", color.new(color.blue, 25))
plot(basis, "Basis", color.new(color.orange, 45))
fill(pUp, pLo, color = inSqueeze ? color.new(color.yellow, 88) : color.new(color.blue, 94))

bgcolor(showBG ? (extreme ? color.new(color.orange, 85) : inSqueeze ? color.new(color.yellow, 91) : na) : na,
     title = "Squeeze Shading")

// Pending breakout levels, drawn only while the setup is live
plot(armed ? boHi : na, "Armed High", color.new(color.green, 0), 1, plot.style_linebr)
plot(armed ? boLo : na, "Armed Low",  color.new(color.red,   0), 1, plot.style_linebr)

// Squeeze consolidation boxes
var box bx = na
if showBox
    if sqzStart
        bx := box.new(bar_index, high, bar_index, low,
             border_color = color.new(color.yellow, 20),
             bgcolor      = color.new(color.yellow, 92))
    else if inSqueeze and not na(bx)
        box.set_right(bx, bar_index)
        box.set_top(bx, sqzHi)
        box.set_bottom(bx, sqzLo)
    else if released and not na(bx)
        if sqzCount < minSqzBars
            box.delete(bx)
            bx := na
        else
            box.set_right(bx, bar_index + boWindow)
            box.set_border_color(bx, color.new(color.gray, 20))

// Breakout markers
if longBO
    label.new(bar_index, low, "▲ BREAKOUT", yloc = yloc.belowbar, style = label.style_label_up,
         color = color.new(color.green, 15), textcolor = color.white, size = size.small)
if shortBO
    label.new(bar_index, high, "▼ BREAKDOWN", yloc = yloc.abovebar, style = label.style_label_down,
         color = color.new(color.red, 15), textcolor = color.white, size = size.small)

// ──────────────────────── INFO TABLE ──────────────────────────
tblPos  = input.string("Bottom Right", "Table Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = grpVIS)
tblLoc = tblPos == "Top Right"    ? position.top_right    :
         tblPos == "Top Left"     ? position.top_left     :
         tblPos == "Bottom Left"  ? position.bottom_left  :
         tblPos == "Middle Right" ? position.middle_right : position.bottom_right

var table t = table.new(tblLoc, 2, 5, border_width = 1)
if showTbl and barstate.islast
    stateTxt = inSqueeze ? (extreme ? "EXTREME SQZ (" : "SQUEEZE (") + str.tostring(sqzCount) + ")"
         : armed ? "ARMED (" + str.tostring(boWindow - barsSince) + " left)" : "neutral"
    stateCol = inSqueeze ? color.new(color.orange, 20) : armed ? color.new(color.blue, 20) : color.new(color.gray, 40)

    table.cell(t, 0, 0, "BB Squeeze", text_color = color.white, bgcolor = color.new(color.navy, 10))
    table.cell(t, 1, 0, timeframe.period, text_color = color.white, bgcolor = color.new(color.navy, 10))
    table.cell(t, 0, 1, "Bandwidth", text_color = color.gray)
    table.cell(t, 1, 1, str.tostring(bbw, "#.###") + "%", text_color = color.white)
    table.cell(t, 0, 2, "Percentile", text_color = color.gray)
    table.cell(t, 1, 2, str.tostring(rank, "#.#") + "%", text_color = inSqueeze ? color.orange : color.white)
    table.cell(t, 0, 3, "State", text_color = color.gray)
    table.cell(t, 1, 3, stateTxt, text_color = color.white, bgcolor = stateCol)
    table.cell(t, 0, 4, "Momentum", text_color = color.gray)
    table.cell(t, 1, 4, mom > 0 ? "Bullish" : "Bearish", text_color = mom > 0 ? color.green : color.red)
